---
import type { GitHubOrg } from "../lib/gh";

interface Props {
  orgBadges: GitHubOrg[];
}

const { orgBadges }: Props = Astro.props;
---

{orgBadges.length > 0 && (
  <nav
    class="my-6 flex w-full max-w-full flex-wrap items-center gap-2 [direction:ltr]"
    aria-label="GitHub organizations"
  >
    {orgBadges.map((orgBadge: GitHubOrg) => (
      <a
        class="inline-flex min-w-0 max-w-full items-center gap-2 rounded-[0.625rem] border border-[var(--link-border)] bg-[var(--link-background)] py-[0.3rem] pr-[0.65rem] pl-[0.35rem] text-sm font-semibold leading-5 text-[var(--link-text)] no-underline [box-shadow:var(--link-shadow)] transition-[background-color,border-color,color,transform] duration-[160ms] hover:-translate-y-px hover:border-[var(--link-hover-border)] hover:bg-[var(--link-hover-background)] hover:text-[var(--link-hover-text)] focus-visible:outline-none focus-visible:[box-shadow:0_0_0_4px_var(--focus-ring)]"
        href={orgBadge.websiteUrl ?? orgBadge.profileUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={
          orgBadge.websiteUrl
            ? `Visit @${orgBadge.login} website`
            : `@${orgBadge.login} on GitHub`
        }
        title={
          orgBadge.websiteUrl
            ? `@${orgBadge.login} website`
            : `@${orgBadge.login} on GitHub`
        }
      >
        <img
          class="size-7 shrink-0 rounded-md object-cover"
          src={orgBadge.avatarUrl}
          alt=""
          width="28"
          height="28"
          loading="lazy"
        />
        <span class="min-w-0 overflow-hidden text-ellipsis whitespace-nowrap">
          @{orgBadge.login}
        </span>
      </a>
    ))}
  </nav>
)}
