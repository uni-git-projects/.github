---
import { type ThemeModalTrans, themeModalSrc } from "../lib/i18n";

interface Props {
  translations?: ThemeModalTrans;
}

const { translations = themeModalSrc } = Astro.props;
---

<button
  id="site-style-toggle"
  type="button"
  class="site-style-toggle group relative inline-grid aspect-square w-11 cursor-pointer place-items-center rounded-full border border-[var(--toggle-border)] bg-[var(--toggle-background)] text-[var(--toggle-text)] [box-shadow:var(--toggle-shadow)] backdrop-blur-[12px] transition-[transform,background-color,border-color,color] duration-[160ms] hover:-translate-y-px hover:scale-[1.03] hover:border-[var(--link-hover-border)] hover:bg-[var(--link-hover-background)] hover:text-[var(--link-hover-text)] focus-visible:[outline:3px_solid_var(--focus-ring)] focus-visible:outline-offset-[3px]"
  aria-label="Switch style"
>
  <span class="text-[1.2rem] font-bold leading-none" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      focusable="false"
    >
      <title data-i18n-style-layers>{translations.styleLayers}</title>
      <path d="m12 2 9 5-9 5-9-5 9-5Z" />
      <path d="m3 12 9 5 9-5" />
      <path d="m3 17 9 5 9-5" />
    </svg>
  </span>
  <span
    class="pointer-events-none invisible absolute right-0 top-[calc(100%+0.5rem)] inline-flex w-max -translate-y-[0.15rem] items-center gap-[0.15rem] whitespace-nowrap rounded-[0.4rem] border border-[var(--toggle-border)] bg-[var(--toggle-background)] px-2 py-[0.35rem] text-xs font-semibold leading-none text-[var(--toggle-text)] opacity-0 [box-shadow:var(--toggle-shadow)] transition-[opacity,transform,visibility] duration-[120ms] group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:visible group-focus-visible:translate-y-0 group-focus-visible:opacity-100"
    aria-hidden="true"
  >
    <span data-site-style-tooltip></span>
  </span>
</button>

<script>
const button: HTMLElement | null = document.getElementById("site-style-toggle");
const root: HTMLElement = document.documentElement;
const dataElement: HTMLElement | null =
  document.getElementById("all-style-data");

if (button instanceof HTMLButtonElement && dataElement) {
  try {
    const payload: { names?: unknown } = JSON.parse(
      dataElement.textContent ?? "{}",
    );

    const names: string[] = Array.isArray(payload.names)
      ? payload.names.filter(
          (name: unknown): name is string =>
            typeof name === "string" && Boolean(name.trim()),
        )
      : [];

    const tooltip: HTMLElement | null = button.querySelector(
      "[data-site-style-tooltip]",
    );

    const syncLabel = (): void => {
      const current: string = root.dataset.themeStyle ?? names[0] ?? "";
      const label: string = current.toLowerCase();

      button.setAttribute(
        "aria-label",
        label ? `Switch style. Current style: ${label}.` : "Switch style",
      );

      if (tooltip) tooltip.textContent = label;
    };

    syncLabel();

    button.addEventListener("click", (): void => {
      const first: string | undefined = names[0];
      if (!first) return;

      const current: string = root.dataset.themeStyle ?? first;
      const currentIndex: number = names.indexOf(current);

      const next: string = names[(currentIndex + 1) % names.length] ?? first;

      window.dispatchEvent(
        new CustomEvent("site-style-select", {
          detail: { style: next },
        }),
      );
    });

    window.addEventListener("site-style-change", syncLabel);
    window.addEventListener("pageshow", syncLabel);
  } catch (error) {
    console.error("Failed to initialize style switcher:", error);
  }
}
</script>
