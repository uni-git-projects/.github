{
  "name": "github-profile-readme-site",
  "version": "1.0.0",
  "description": "A configurable static GitHub profile site template for rendering README Markdown content with avatar & optional tagline, i18n translations, themes, styles, org badge & web icon links.",
  "private": true,
  "type": "module",
  "author": "profile-icons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profile-icons/github-profile-readme-site.git"
  },
  "bugs": {
    "url": "https://github.com/profile-icons/github-profile-readme-site/issues"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "i18n": "node scripts/i18n-trans.mjs",
    "dev": "npm run i18n && astro dev",
    "build": "npm run i18n && astro build",
    "preview": "astro preview",
    "verify": "biome check . && astro check && tsc --noEmit",
    "verify:fix": "biome check --write . && astro check && tsc --noEmit"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@huggingface/transformers": "^4.3.0",
    "astro": "^7.3.3",
    "bootstrap-icons": "^1.13.1",
    "emoji-regex": "^11.0.0",
    "marked": "^18.0.13",
    "simple-icons": "^16.31.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
