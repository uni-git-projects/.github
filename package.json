{
  "name": "github-profile-site",
  "version": "1.0.0",
  "description": "Configurable GitHub profile site with avatar & optional tagline, translations, themes, & icon links.",
  "private": true,
  "type": "module",
  "author": "profile-icons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profile-icons/github-profile-site.git"
  },
  "bugs": {
    "url": "https://github.com/profile-icons/github-profile-site/issues"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "i18n": "node scripts/i18n-trans.ts",
    "dev": "npm run i18n && astro dev",
    "build": "npm run i18n && astro build",
    "preview": "astro preview",
    "verify": "biome check . && astro check && tsc --noEmit",
    "verify:fix": "biome check --write . && astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@huggingface/transformers": "^4.3.2",
    "astro": "^7.4.12",
    "bootstrap-icons": "^1.13.2",
    "emoji-regex": "^11.0.0",
    "marked": "^18.2.0",
    "simple-icons": "^16.37.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.7",
    "globals": "^17.14.0",
    "sass": "^1.108.2",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "@parcel/watcher@2.6.0": true
  }
}
